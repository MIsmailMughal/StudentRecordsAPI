{
  "info": {
    "name": "Student Records API - SQE",
    "description": "22 ordered requests with automated assertions. Uses fictional data. Run TC01 to TC22. TC02 generates a unique roll number and captures the new ID; TC18 deletes that record only. Existing records are not cleared. Do not define environment variables named baseUrl, studentId or rollNo, because they override collection values. Actual Postman evidence must be captured by the student.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "rollNo",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "TC01 - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Database connected; status ok. Run requests in numbered order. Capture your own evidence."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"TC01: status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\").includes(\"application/json\")).to.equal(true); });",
              "const apiPayload = pm.response.json();",
              "pm.test(\"Database is connected\", function () { pm.expect(apiPayload).to.eql({status:\"ok\", database:\"connected\"}); });",
              "})();"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "TC02 - Create valid student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students",
        "description": "Record created with unique ID; database gains one row. Run requests in numbered order. Capture your own evidence.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Ahmed\",\n  \"rollNo\": \"{{rollNo}}\",\n  \"department\": \"Software Engineering\",\n  \"semester\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"studentId\");",
              "pm.collectionVariables.set(\"rollNo\", \"PM\" + Date.now() + Math.floor(Math.random()*10000).toString().padStart(4,\"0\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"TC02: status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Response is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\").includes(\"application/json\")).to.equal(true); });",
              "const apiPayload = pm.response.json();",
              "pm.test(\"Created record is correct\", function () { pm.expect(apiPayload.name).to.equal(\"Ali Ahmed\"); pm.expect(apiPayload.rollNo).to.equal(pm.collectionVariables.get(\"rollNo\")); pm.expect(apiPayload.department).to.equal(\"Software Engineering\"); pm.expect(apiPayload.semester).to.equal(1); pm.expect(Number.isInteger(apiPayload.id) && apiPayload.id > 0).to.equal(true); });",
              "if (pm.response.code === 201 && Number.isInteger(apiPayload.id)) { pm.collectionVariables.set(\"studentId\", String(apiPayload.id)); }",
              "})();"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "TC03 - Read all students",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students",
        "description": "JSON array contains the created student. Run requests in numbered order. Capture your own evidence."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"TC03: status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\").includes(\"application/json\")).to.equal(true); });",
              "const apiPayload = pm.response.json();",
              "pm.test(\"List includes created student\", function () { pm.expect(Array.isArray(apiPayload)).to.equal(true); pm.expect(apiPayload.some(s => s.id === Number(pm.collectionVariables.get(\"studentId\")) && s.rollNo === pm.collectionVariables.get(\"rollNo\"))).to.equal(true); });",
              "})();"
            ]
          }
        }
      ],
      "response": []
    },
